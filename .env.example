APP_NAME="AI Customer Feedback Intelligence Platform"
DEBUG=true
API_PORT=8000

DATABASE_URL=postgresql://feedback_app:feedback_app_dev_pw@localhost:5432/feedback_intelligence

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CHROMA_PERSIST_DIR=./data/chroma

# docker-compose.yml only: builds the containerized Postgres and the app's
# DATABASE_URL inside the compose network. Not read by local `uvicorn` runs.
POSTGRES_USER=feedback_app
POSTGRES_PASSWORD=feedback_app_dev_pw
POSTGRES_DB=feedback_intelligence
UVICORN_WORKERS=2
