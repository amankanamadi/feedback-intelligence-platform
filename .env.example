APP_NAME="AI Customer Feedback Intelligence Platform"
DEBUG=true
API_PORT=8000

DATABASE_URL=postgresql://feedback_app:feedback_app_dev_pw@localhost:5432/feedback_intelligence

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Auth - generate with `openssl rand -hex 32`. Required (non-empty) unless
# DEBUG=true. Never commit a real value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# True in prod (requires HTTPS); False for local http dev.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# JSON array of allowed origins for the Next.js frontend (CORS + cookies).
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# docker-compose.yml only: builds the containerized Postgres and the app's
# DATABASE_URL inside the compose network. Not read by local `uvicorn` runs.
POSTGRES_USER=feedback_app
POSTGRES_PASSWORD=feedback_app_dev_pw
POSTGRES_DB=feedback_intelligence
UVICORN_WORKERS=2
